# Dependencies
**/node_modules/

# Secrets and environment files (at any directory depth)
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/.envrc
**/.direnv/

# Package-manager authentication and local configuration
**/.npmrc
**/.yarnrc
**/.pnpmrc

# Private keys, certificates, signing files, and service credentials
**/*.pem
**/*.key
**/*.ppk
**/*.crt
**/*.cer
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.mobileprovision
**/credentials.json
**/credentials.*.json
**/service-account.json
**/service-account-*.json
**/google-credentials.json
**/id_rsa
**/id_rsa.*
**/id_ed25519
**/id_ed25519.*
**/.aws/credentials
**/.config/gcloud/application_default_credentials.json
**/.kube/config

# Deployment-provider local state
**/.vercel/
**/.render/
**/.netlify/

# Terraform state can contain plaintext secrets
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/.terraform.lock.hcl.backup

# Build output and framework caches
**/build/
**/dist/
**/.next/
**/out/
**/.turbo/
**/.cache/
**/.parcel-cache/
**/*.tsbuildinfo

# Test and coverage output
**/coverage/
**/.nyc_output/
**/test-results/
**/playwright-report/
**/blob-report/

# Logs, diagnostics, and process files
**/logs/
**/*.log
**/*.log.*
**/*.pid
**/*.pid.lock
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# Local databases, dumps, and exported user data
**/*.db
**/*.db-journal
**/*.sqlite
**/*.sqlite3
**/*.bson
**/*.dump
**/*.bak
**/dump/
**/dumps/
**/backups/
data.txt

# Temporary files
**/tmp/
**/temp/
**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*~

# IDE and operating-system files
**/.idea/
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.example.json
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln

# Local Codex/agent workspace state
**/.codex/
**/.agents/
